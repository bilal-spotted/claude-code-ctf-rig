{
  "mcpServers": {
    "burp": {
      "command": "/usr/lib/jvm/java-21-openjdk-amd64/bin/java",
      "args": [
        "-jar",
        "/home/YOUR_USERNAME/.BurpSuite/mcp-proxy/mcp-proxy-all.jar",
        "--sse-url",
        "http://127.0.0.1:9876"
      ]
    },
    "ghydra": {
      "command": "python3",
      "args": [
        "/home/YOUR_USERNAME/tools/GhydraMCP/complete/bridge_mcp_hydra.py"
      ],
      "env": {
        "GHIDRA_HYDRA_HOST": "localhost"
      }
    }
  }
}
